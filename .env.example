# Local development (matches docker-compose.yml)
DATABASE_URL=postgres://pkg_compliance:pkg_compliance@localhost:5433/pkg_compliance

# Claude API — extraction pipeline (Sprint 2)
ANTHROPIC_API_KEY=

# Access gate (production only). When BOTH are set, every route requires HTTP
# Basic Auth (client BOM data must not sit on an open URL). Leave unset locally.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Primary-source approval allowlist can be extended at runtime (comma-separated):
# CORPUS_PRIMARY_SOURCE_DOMAINS=
