{
  "name": "pkg-compliance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "drizzle-kit migrate && next build",
    "lint": "eslint",
    "check:language": "node scripts/check-language.ts",
    "test": "node --test \"tests/**/*.test.ts\" \"eval/**/*.test.ts\"",
    "check": "npm run lint && npm run check:language && next typegen && tsc --noEmit && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:demo": "node --env-file=.env scripts/seed-demo.ts",
    "seed:demo-suite": "node --env-file=.env scripts/seed-demo-suite.ts",
    "seed:factors": "node --env-file=.env scripts/seed-factors.ts",
    "smoke": "node scripts/smoke.ts",
    "corpus:review": "node scripts/corpus-review.ts",
    "corpus:approve": "node scripts/corpus-approve.ts",
    "corpus:reject": "node scripts/corpus-reject.ts",
    "corpus:verify": "node scripts/corpus-verify.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
